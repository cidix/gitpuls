[Unit]
Description=gitpuls: Sternstände fremder Repos (Search-API)
After=docker.service
Requires=docker.service

[Service]
# Beispielpfad: der Checkout liegt unter /opt/gitpuls; liegt er anderswo, hier und bei EnvironmentFile anpassen.
Type=oneshot
WorkingDirectory=/opt/gitpuls
ExecStart=/usr/bin/docker compose run --rm --user 10001:10001 gitpuls python -m app.sterne
TimeoutStartSec=600
