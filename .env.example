# Settings for compose.yaml. Copy to .env and fill in. Required: TZ and GITPULS_ADRESSEN.
# Time zone of the operator (IANA name). Days, weeks and months are counted in this zone.
TZ=Europe/Berlin
# Commit email addresses that count as yours, comma separated (git config user.email; add your users.noreply.github.com address).
GITPULS_ADRESSEN=you@example.org
# Interface language, en or de. Number and date format: a locale such as en-GB or de-CH; empty follows Accept-Language.
GITPULS_SPRACHE=en
GITPULS_FORMAT=
# Port on 127.0.0.1. The service is never published on other interfaces; put an authenticating reverse proxy in front of it.
GITPULS_PORT=8789
# Host names allowed in the Host header (DNS rebinding protection), comma separated, e.g. the name of your reverse proxy.
# Loopback is always allowed.
GITPULS_HOSTS=
# File with GITHUB_TOKEN=... (fine-grained PAT, read only: Contents, Metadata, Actions, Dependabot alerts). Template: deploy/github.env.beispiel
GITPULS_TOKENDATEI=./github.env
# Docker volume for the database. To keep an existing volume safe from `down -v`, see compose.override.yaml in the README.
GITPULS_VOLUME=gitpuls-daten
# Collector interval inside the container in minutes; the star ranking runs once a day. 0 disables it (use the host timers in deploy/).
GITPULS_TAKT_MIN=60
# Your own languages and topics for the ranking of rising repos, comma separated, e.g. python,typescript.
GITPULS_STACK=
# Image tag; empty uses the default in compose.yaml.
GITPULS_TAG=
# Server zone (optional, host timers in deploy/): product line of the machine, service table, target paths.
GITPULS_PRODUKT=
GITPULS_DIENSTE=
